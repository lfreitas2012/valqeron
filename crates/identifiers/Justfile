# Fuzzing commands for valqeron-identifiers.

_fuzz-setup:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! rustup toolchain list | grep -q '^nightly'; then
        rustup toolchain install nightly --profile minimal
    fi
    if ! cargo +nightly fuzz --version >/dev/null 2>&1; then
        cargo +nightly install cargo-fuzz --locked
    fi

# Build every fuzz target.
fuzz-build: _fuzz-setup
    cargo +nightly fuzz build --fuzz-dir fuzz

# Run a fuzz target for a bounded time.
# Example: `just --justfile crates/identifiers/Justfile fuzz country_code`.
fuzz target time="60": _fuzz-setup
    mkdir -p fuzz/corpus/{{ target }}
    cargo +nightly fuzz run --fuzz-dir fuzz {{ target }} fuzz/corpus/{{ target }} fuzz/seeds/{{ target }} -- -dict=fuzz/dict/{{ target }}.dict -max_total_time={{ time }}

# Run every fuzz target for the requested bounded time.
fuzz-all time="60": _fuzz-setup
    #!/usr/bin/env bash
    set -euo pipefail
    for target_path in fuzz/fuzz_targets/*.rs; do
        target="${target_path##*/}"
        target="${target%.rs}"
        just --justfile Justfile fuzz "$target" "{{ time }}"
    done

# Show line coverage of a fuzz target over its corpus, then print a summary report.
fuzz-coverage target: _fuzz-setup
    #!/usr/bin/env bash
    set -euo pipefail
    rustup component add llvm-tools --toolchain nightly
    mkdir -p crates/identifiers/fuzz/corpus/{{ target }}
    cargo +nightly fuzz coverage --fuzz-dir fuzz {{ target }} crates/identifiers/fuzz/corpus/{{ target }} crates/identifiers/fuzz/seeds/{{ target }}
    triple="$(rustc +nightly -vV | sed -n 's/host: //p')"
    llvm_cov="$(rustc +nightly --print sysroot)/lib/rustlib/${triple}/bin/llvm-cov"
    case "{{ target }}" in
        country_code) module="country" ;;
        *) module="{{ target }}" ;;
    esac
    "${llvm_cov}" report \
        "crates/identifiers/fuzz/target/${triple}/coverage/${triple}/release/{{ target }}" \
        -instr-profile="crates/identifiers/fuzz/coverage/{{ target }}/coverage.profdata" \
        -sources "src/${module}.rs" "src/${module}"
