<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  Development LaunchAgent for the Valqeron engine.

  One-time setup:
    cp scripts/install/io.valqeron.engine.plist.example \
       scripts/install/io.valqeron.engine.plist

  Then edit every CHANGE-ME below.

  launchd does not expand shell variables such as $HOME or ~.
  All paths must therefore be absolute.

  `just engine-install` copies this machine-local definition to
  ~/Library/LaunchAgents/ and registers it with launchd.

  The machine-local copy under scripts/install/ is gitignored.
-->
<plist version="1.0">
<dict>

  <!-- Service identity -->
  <key>Label</key>
  <string>io.valqeron.engine</string>

  <!--
    The engine intentionally takes no command-line arguments.
    Runtime configuration is supplied exclusively through VALQERON_*.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/CHANGE-ME/valqeron/target/release/valqeron-engine</string>
  </array>

  <!--
    launchd does not inherit the interactive shell environment.
    Required VALQERON_* configuration must therefore be declared here.
  -->
  <key>EnvironmentVariables</key>
  <dict>

    <!-- Persistent SQLite database -->
    <key>VALQERON_DB</key>
    <string>/Users/CHANGE-ME/Library/Application Support/io.valqeron.valqeron/valqeron.db</string>

    <!-- Unix domain socket used by clients -->
    <key>VALQERON_SOCKET</key>
    <string>/Users/CHANGE-ME/Library/Application Support/io.valqeron.valqeron/run/valqeron.sock</string>

    <!-- Structured JSON engine log -->
    <key>VALQERON_ENGINE_LOG_FILE</key>
    <string>/Users/CHANGE-ME/Library/Application Support/io.valqeron.valqeron/engine.log</string>

    <!-- File logging verbosity -->
    <key>VALQERON_ENGINE_LOG_LEVEL</key>
    <string>info</string>

    <!--
      0 = normal durability
      1 = strict durability (PRAGMA synchronous=FULL)
    -->
    <key>VALQERON_ENGINE_DURABLE</key>
    <string>0</string>

  </dict>

  <!-- Start immediately when the LaunchAgent is loaded -->
  <key>RunAtLoad</key>
  <true/>

  <!--
    Restart only after an unsuccessful exit.
    A graceful exit remains stopped.
  -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Avoid rapid restart loops -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- Background service -->
  <key>ProcessType</key>
  <string>Background</string>

  <!--
    Must exceed the engine's internal drain (10s) plus runtime
    shutdown (20s), preventing launchd from truncating graceful
    shutdown/checkpoint processing.
  -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <!--
    Persistent application logging is handled by tracing_appender.
    launchd stdout/stderr are intentionally discarded.
  -->
  <key>StandardOutPath</key>
  <string>/dev/null</string>

  <key>StandardErrorPath</key>
  <string>/dev/null</string>

</dict>
</plist>
